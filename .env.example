# Copy to .env and fill in what you have. Every integration is optional —
# anything left blank runs in mock mode and its results are flagged as
# simulated so Lumia reports them as UNKNOWN rather than as fact.

# --- Required to run the agent ---------------------------------------
ANTHROPIC_API_KEY=

# --- Model configuration ---------------------------------------------
# claude-opus-5 is the default. Effort: low | medium | high | xhigh | max
# Set this to a GPT model (gpt-4o, o3-mini, ...) and the agents run on
# OpenAI instead — the provider follows the model name, there is no second
# switch. OPENAI_API_KEY below is then required.
ASHRAH_MODEL=claude-opus-5
ASHRAH_EFFORT=high

# --- OpenAI ----------------------------------------------------------
# Whisper transcribes the voice notes crews send in Arabic, Kurdish and
# French; vision reads submitted photos; embeddings let memory recall a
# lesson by meaning rather than by shared keywords. All optional — without
# this key, transcription refuses rather than inventing a transcript, and
# memory falls back to keyword matching.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Company identity -------------------------------------------------
COMPANY_NAME=Ashrah Painting Ltd.
# Outbound email is refused unless COMPANY_EMAIL is set.
COMPANY_EMAIL=
COMPANY_PHONE=

# --- CRM (record of truth) -------------------------------------------
# Leave blank to use the built-in local JSON store under data/.
CRM_API_KEY=
CRM_BASE_URL=

# --- Email (SendGrid-shaped) -----------------------------------------
# Used for outreach and for project communication: daily logs, client
# updates, supplier orders.
SENDGRID_API_KEY=

# --- SMS (Twilio) — all three are required for live sending ----------
# Site coordination: arrival notices, access, crew dispatch, confirmations.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Meetings (Google Calendar) --------------------------------------
GOOGLE_CALENDAR_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Market research --------------------------------------------------
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web

# --- Permits / tenders / project awards -------------------------------
CONSTRUCTION_DATA_API_KEY=
CONSTRUCTION_DATA_BASE_URL=

# --- Weather (exterior scheduling) ------------------------------------
OPENWEATHER_API_KEY=

# --- Fleet (L5) -------------------------------------------------------
# What this runtime is called in the shared registry. Defaults to hostname.
# LUMIA_NODE=scheduler-1
#
# Runtimes coordinate through the shared registry, not by calling each
# other. Name a peer here only if a direct route is genuinely intended.
# LUMIA_APPROVED_RUNTIMES=

# --- Contract enforcement ---------------------------------------------
# A run that reaches outside its contract — a tool its phase does not hold,
# a tool that does not exist, or an HTTP call to a host this deployment is
# not configured for — is killed on the spot. Set to `refuse` to let the
# agent be told no and carry on instead.
# LUMIA_ON_BREACH=kill
#
# Outbound calls are limited to the hosts of configured integrations plus
# the model providers. Media and recordings usually live somewhere else —
# name those hosts here, comma-separated.
# LUMIA_ALLOWED_HOSTS=media.example.com,cdn.example.com

# --- Time budgets -----------------------------------------------------
# Runs are uncapped by default: an incomplete message costs more than a
# slow one, and runs are stopped by an operator rather than a clock
# (`lumia kill RUN-000042`). Set a number of seconds here to cap them —
# useful for a web request that has to return, or a scheduled job that
# must not overlap the next one. Leave blank for no limit.
# LUMIA_COMMS_BUDGET_SECONDS=
# LUMIA_GROWTH_BUDGET_SECONDS=

# --- Storage ----------------------------------------------------------
# Where projects, communications, approvals and run numbers are kept.
# Defaults to ./data. On a container host this must point at a mounted
# volume — anything else is erased on redeploy, run counter included.
# ASHRAH_DATA_DIR=./data

# --- Clock ------------------------------------------------------------
# Containers usually run UTC. A daily log dated in UTC rolls over at 8pm
# local and files the evening's work under tomorrow, so set the timezone
# the jobsites are actually in.
# TZ=America/Toronto

# --- Web server -------------------------------------------------------
# Both are read from the environment; hosts that inject PORT are already
# handled. Set them only when running the control room yourself.
# PORT=8000
# HOST=0.0.0.0
#
# The API is read-only unless this is set, in which case /api/run will
# start real runs for anyone holding the token. Leave unset when the URL
# is public.
# LUMIA_RUN_TOKEN=
