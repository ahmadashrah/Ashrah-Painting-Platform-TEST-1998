# Copy to .env and fill in what you have. Every integration is optional —
# anything left blank runs in mock mode and its results are flagged as
# simulated so Lumia reports them as UNKNOWN rather than as fact.

# --- Required to run the agent ---------------------------------------
ANTHROPIC_API_KEY=

# --- Model configuration ---------------------------------------------
# claude-opus-5 is the default. Effort: low | medium | high | xhigh | max
ASHRAH_MODEL=claude-opus-5
ASHRAH_EFFORT=high

# --- Company identity -------------------------------------------------
COMPANY_NAME=Ashrah Painting Ltd.
# Outbound email is refused unless COMPANY_EMAIL is set.
COMPANY_EMAIL=
COMPANY_PHONE=

# --- CRM (record of truth) -------------------------------------------
# Leave blank to use the built-in local JSON store under data/.
CRM_API_KEY=
CRM_BASE_URL=

# --- Outreach email (SendGrid-shaped) --------------------------------
SENDGRID_API_KEY=

# --- SMS (Twilio) — all three are required for live sending ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Meetings (Google Calendar) --------------------------------------
GOOGLE_CALENDAR_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Market research --------------------------------------------------
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web

# --- Permits / tenders / project awards -------------------------------
CONSTRUCTION_DATA_API_KEY=
CONSTRUCTION_DATA_BASE_URL=

# --- Weather (exterior scheduling) ------------------------------------
# Without this the scheduler reports exterior conditions as UNKNOWN rather
# than assessing them — a simulated forecast must never gate real coating work.
OPENWEATHER_API_KEY=

# --- Operations: projects, crews, shifts, time off ---------------------
# Leave blank to use the built-in local JSON store under data/.
OPERATIONS_API_KEY=
OPERATIONS_BASE_URL=

# --- Timeclock (clock-in / clock-out) ---------------------------------
# Without this, attendance and actual hours are UNKNOWN. The timeclock
# integration returns nothing rather than plausible-looking punches:
# fabricated attendance data is worse than none.
TIMECLOCK_API_KEY=
TIMECLOCK_BASE_URL=

# --- Storage ----------------------------------------------------------
# ASHRAH_DATA_DIR=./data
